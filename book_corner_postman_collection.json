{
	"info": {
		"_postman_id": "a90df1b3-4f9e-4e89-b9d1-872f2323a678",
		"name": "Book Corner API",
		"description": "Complete collection for Book Corner REST API including public storefront and admin endpoints.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Public / Storefront",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						}
					}
				},
				{
					"name": "List Books (Published)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/books?query=&genre=&tag=&page=1&limit=12",
							"host": ["{{base_url}}"],
							"path": ["books"],
							"query": [
								{ "key": "query", "value": "", "description": "Full-text search" },
								{ "key": "genre", "value": "", "description": "Tag filter" },
								{ "key": "tag", "value": "", "description": "Tag filter" },
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "12" }
							]
						}
					}
				},
				{
					"name": "Get Book by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/books/1",
							"host": ["{{base_url}}"],
							"path": ["books", "1"]
						}
					}
				},
				{
					"name": "List Tags",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/tags",
							"host": ["{{base_url}}"],
							"path": ["tags"]
						}
					}
				},
				{
					"name": "Get Quiz Questions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/quiz/questions",
							"host": ["{{base_url}}"],
							"path": ["quiz", "questions"]
						}
					}
				},
				{
					"name": "Recommend Books (Quiz)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"answers\": [\n    { \"question_id\": 1, \"option_id\": 1 },\n    { \"question_id\": 2, \"option_id\": 4 }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/quiz/recommend",
							"host": ["{{base_url}}"],
							"path": ["quiz", "recommend"]
						}
					}
				},
				{
					"name": "Place Order (Pay on Delivery)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customer_name\": \"Amaka Obi\",\n  \"phone\": \"+2348012345678\",\n  \"email\": \"amaka@example.com\",\n  \"address\": \"14 Broad Street, Lagos Island\",\n  \"note\": \"Please call before delivery\",\n  \"payment_method\": \"pay_on_delivery\",\n  \"items\": [\n    {\n      \"book_id\": 1,\n      \"quantity\": 1\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/orders",
							"host": ["{{base_url}}"],
							"path": ["orders"]
						}
					}
				}
			]
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Admin Login",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@bookcorner.com\",\n  \"password\": \"yourpassword\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/login",
							"host": ["{{base_url}}"],
							"path": ["admin", "login"]
						}
					}
				},
				{
					"name": "List All Books (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/books?page=1&limit=12",
							"host": ["{{base_url}}"],
							"path": ["admin", "books"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "12" }
							]
						}
					}
				},
				{
					"name": "Lookup Book Metadata",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/books/lookup?q=9780752877198",
							"host": ["{{base_url}}"],
							"path": ["admin", "books", "lookup"],
							"query": [
								{ "key": "q", "value": "9780752877198" }
							]
						}
					}
				},
				{
					"name": "Create Book",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Atomic Habits\",\n  \"author\": \"James Clear\",\n  \"description\": \"An easy and proven way to build good habits and break bad ones.\",\n  \"price\": 5000,\n  \"stock\": 10,\n  \"image_url\": \"https://images.example.com/cover.jpg\",\n  \"status\": \"published\",\n  \"tag_ids\": [1, 2]\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/books",
							"host": ["{{base_url}}"],
							"path": ["admin", "books"]
						}
					}
				},
				{
					"name": "Update Book",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Atomic Habits (Updated Edition)\",\n  \"author\": \"James Clear\",\n  \"description\": \"Updated description...\",\n  \"price\": 5500,\n  \"stock\": 12,\n  \"image_url\": \"https://images.example.com/cover.jpg\",\n  \"status\": \"published\",\n  \"tag_ids\": [1, 3]\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/books/1",
							"host": ["{{base_url}}"],
							"path": ["admin", "books", "1"]
						}
					}
				},
				{
					"name": "Toggle Book Status",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"draft\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/books/1/status",
							"host": ["{{base_url}}"],
							"path": ["admin", "books", "1", "status"]
						}
					}
				},
				{
					"name": "Delete Book",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{base_url}}/admin/books/1",
							"host": ["{{base_url}}"],
							"path": ["admin", "books", "1"]
						}
					}
				},
				{
					"name": "Create Tag",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Psychology\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/tags",
							"host": ["{{base_url}}"],
							"path": ["admin", "tags"]
						}
					}
				},
				{
					"name": "Replace Book Tags",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tag_ids\": [1, 2, 4]\n}"
						},
						"url": {
							"raw": "{{base_url}}/admin/books/1/tags",
							"host": ["{{base_url}}"],
							"path": ["admin", "books", "1", "tags"]
						}
					}
				}
			]
		}
	]
}
